<http://www.semanticweb.org/schlosseryan/ontologies/2026/2/MarketCapitalizationOntology> a owl:Ontology ;
    rdfs:comment """Ontology Mapping the Semiconductor Supply Chain Assumptions used within the Work of the Industrial Alliance on Processors and Semiconductor Technologies.
Integration of Semiconductor Industry Market Capitalization for Stress Test Working Group.""" ;
    rdfs:isDefinedBy "Yannic Schlosser (GSD SID IN) Christine O'Brien (GSD SID IN)" .

:China a owl:Class,
        owl:NamedIndividual ;
    rdfs:comment """Geographic region: China.
Headquarters location for semiconductor companies including SMIC, YMTC, Naura Technology, Cambricon Technology, Will Semiconductor, and Huawei.""" ;
    rdfs:subClassOf :Region .

