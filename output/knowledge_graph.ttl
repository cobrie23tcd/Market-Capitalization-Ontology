:Japan a owl:Class,
        owl:NamedIndividual ;
    rdfs:comment """Geographic region: Japan.
Headquarters location for semiconductor companies including Tokyo Electron, Advantest, Murata, TDK, Hamamatsu Photonics, and Tokyo Ohka Kogyo.""" ;
    rdfs:subClassOf :Region .

:Other a owl:Class,
        owl:NamedIndividual ;
    rdfs:comment """Geographic region: Rest of World.
Captures all regions not individually modelled — primarily Europe — including headquarters of companies such as ASML, ASM International, Infineon, STMicroelectronics, NXP, Soitec, Siltronic, and Aixtron.""" ;
    rdfs:subClassOf :Region .

:South_Korea a owl:Class,
        owl:NamedIndividual ;
    rdfs:comment """Geographic region: South Korea.
Headquarters location for major IDM and memory companies including Samsung and SK Hynix.""" ;
    rdfs:subClassOf :Region .

:Taiwan a owl:Class,
        owl:NamedIndividual ;
    rdfs:comment """Geographic region: Taiwan.
Headquarters location for major foundry and OSAT companies including TSMC, UMC, ASE, GlobalWafers, MediaTek, Realtek, and Compal Electronics.""" ;
    rdfs:subClassOf :Region .

:USA a owl:Class,
        owl:NamedIndividual ;
    rdfs:comment """Geographic region: United States of America.
Headquarters location for major fabless, IDM, and equipment companies including NVIDIA, AMD, Qualcomm, Intel, Applied Materials, KLA, and Lam Research.""" ;
    rdfs:subClassOf :Region .

:flowsGoodsTo a owl:ObjectProperty ;
    rdfs:comment "Indicates that physical goods (e.g. materials, wafers, components, finished devices) flow from the subject Cluster to the object Cluster. Inverse of recievesGoodsFrom." ;
    rdfs:domain :Cluster ;
    rdfs:range :Cluster ;
    owl:inverseOf :recievesGoodsFrom .

:flowsInformationTo a owl:ObjectProperty ;
    rdfs:comment "Indicates that information (e.g. designs, specifications, forecasts, orders) flows from the subject Cluster to the object Cluster. Inverse of recievesInformationFrom." ;
    rdfs:domain :Cluster ;
    rdfs:range :Cluster ;
    owl:inverseOf :recievesInformationFrom .

:flowsMoneyTo a owl:ObjectProperty ;
    rdfs:comment "Indicates that monetary value (e.g. payments, revenue) flows from the subject Cluster to the object Cluster. Inverse of recievesMoneyFrom." ;
    rdfs:domain :Cluster ;
    rdfs:range :Cluster ;
    owl:inverseOf :recievesMoneyFrom .

:hasCompany a owl:ObjectProperty ;
    rdfs:comment "Relates a Cluster to a Company that operates within it. Inverse of isInCluster." ;
    rdfs:domain :Cluster ;
    rdfs:range :Company ;
    owl:inverseOf :isInCluster .

:hasConcentrationInRegion a owl:DatatypeProperty ;
    rdfs:comment "The proportion (0.0–1.0, xsd:decimal) of a Company's operations or market capitalization concentrated in a given Region in a Regional_Concentration report. Per company, the sum across all regions = 1.0." ;
    rdfs:domain :Regional_Concentration ;
    rdfs:range xsd:decimal .

:hasHeadquartersIn a owl:ObjectProperty ;
    rdfs:comment "Associates an Organisation (e.g. Company) with the Region in which its corporate headquarters are located. Enables regional aggregation of market capitalization and supply-chain exposure." ;
    rdfs:domain :Organisation ;
    rdfs:range :Region .

:hasMarketCapitalizationValueBillionsUSD a owl:DatatypeProperty ;
    rdfs:comment "The market capitalization value reported by a Market_Capitalization individual, expressed in billions of US dollars (xsd:decimal)." ;
    rdfs:domain :Market_Capitalization ;
    rdfs:range xsd:decimal .

:hasProportionInCluster a owl:DatatypeProperty ;
    rdfs:comment "The proportion (0.0–1.0, xsd:decimal) of a Company's market capitalization allocated to a given Cluster in a Market_Capitalization report. Per company, the sum across all clusters = 1.0." ;
    rdfs:domain :Market_Capitalization ;
    rdfs:range xsd:decimal .

:reportsOnCluster a owl:ObjectProperty ;
    rdfs:comment "Links a Market_Capitalization report to the Cluster whose market capitalization it characterises." ;
    rdfs:domain :Market_Capitalization ;
    rdfs:range :Cluster .

:reportsOnCompany a owl:ObjectProperty ;
    rdfs:comment "Links a Market_Capitalization or Regional_Concentration report to the Company it characterises." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Market_Capitalization :Regional_Concentration ) ] ;
    rdfs:range :Company .

:reportsOnRegion a owl:ObjectProperty ;
    rdfs:comment "Links a Regional_Concentration report to the Region it characterises (e.g. share of global market capitalization or supply-chain capacity attributed to that Region)." ;
    rdfs:domain :Regional_Concentration ;
    rdfs:range :Region .

:snapshotDate a owl:ObjectProperty ;
    rdfs:comment "Records the snapshot date of a Market_Capitalization or Regional_Concentration report (the point in time the reported figures correspond to)." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Market_Capitalization :Regional_Concentration ) ] .

time:inXSDDateTimeStamp a owl:AnnotationProperty .

:Components_Cluster a :Components_Cluster,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:comment "Cluster Components - Companies that supply non-semiconductor electro-mechanical and passive building blocks used on and around PCBs and within system wiring: passives (capacitors, resistors, inductors); interconnects and electromechanical (gconnectors, sockets, switches, cable/wire harnesses, terminals); EMI/EMC and power components (EMI filters, ferrites, bus bars, power connectors, protection); and related sensors/controls" ;
    rdfs:subClassOf :Customer_Cluster .

:Electronic_Manufacturing_Services_and_Original_Design_Manufacturer_Cluster a :Electronic_Manufacturing_Services_and_Original_Design_Manufacturer_Cluster,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:comment "Cluster EMS/ODM - EMS/ODM partners design, source, assemble, and test electronics—from PCBAs and modules to full systems—for brand-name OEMs; EMS focuses on manufacturing/operations, while ODMs additionally own product designs that customers rebrand. These firms drive NPI/DFx, global supply chains, and box-build integration" ;
    rdfs:subClassOf :Customer_Cluster .

:isInCluster a owl:ObjectProperty ;
    rdfs:comment "Assigns a Company to one or more supply-chain Clusters reflecting its functional role(s) in the semiconductor ecosystem. Inverse of hasCompany." ;
    rdfs:domain :Company ;
    rdfs:range :Cluster .

:recievesGoodsFrom a owl:ObjectProperty ;
    rdfs:comment "Indicates that the subject Cluster receives physical goods from the object Cluster. Inverse of flowsGoodsTo." ;
    rdfs:domain :Cluster ;
    rdfs:range :Cluster .

:recievesInformationFrom a owl:ObjectProperty ;
    rdfs:comment "Indicates that the subject Cluster receives information from the object Cluster. Inverse of flowsInformationTo." ;
    rdfs:domain :Cluster ;
    rdfs:range :Cluster .

:recievesMoneyFrom a owl:ObjectProperty ;
    rdfs:comment "Indicates that the subject Cluster receives monetary value from the object Cluster. Inverse of flowsMoneyTo." ;
    rdfs:domain :Cluster ;
    rdfs:range :Cluster .

:Organisation a owl:Class ;
    rdfs:comment "A legal or institutional entity (e.g. company, association, research institute, public body) that can participate in the semiconductor ecosystem. Serves as the superclass of Company and provides a generic anchor for any organisational actor referenced in the ontology." .

:Report a owl:Class ;
    rdfs:comment "Top-level class for market analysis reports. Subclass: Market_Capitalization " .

<http://www.semanticweb.org/schlosseryan/ontologies/2026/2/MarketCapitalizationOntology/Research_&_Development_and_Academia_Cluster> a <http://www.semanticweb.org/schlosseryan/ontologies/2026/2/MarketCapitalizationOntology/Research_&_Development_and_Academia_Cluster>,
        owl:Class,
        owl:NamedIndividual ;
    :flowsGoodsTo :Intellectual_Property_and_Electronic_Design_Automation_Cluster ;
    :recievesInformationFrom :Intellectual_Property_and_Electronic_Design_Automation_Cluster ;
    :recievesMoneyFrom :Intellectual_Property_and_Electronic_Design_Automation_Cluster ;
    rdfs:comment "Cluster R&D/Academia - Universities and public research organizations that educate talent and run shared cleanrooms, pilot lines, and design ecosystems for semiconductor R&D—often in close partnership with industry. This includes academic nanofabs and mission-driven R&D hubs that provide CAD/PDK access, process labs, and prototyping." ;
    rdfs:subClassOf :Industrial_Alliance_Supply_Chain_Cluster .

:Company a owl:Class ;
    rdfs:comment "A commercial Organisation (legal entity) that participates in the semiconductor value chain, either as a supplier within the Industrial Alliance supply chain or as a downstream customer. A Company is assigned to one or more Clusters via the isInCluster property and is the subject of Market_Capitalization reports." ;
    rdfs:subClassOf :Organisation .

:Applications_Cluster a :Applications_Cluster,
        owl:Class,
        owl:NamedIndividual ;
    :flowsInformationTo :Customer_Cluster ;
    :flowsMoneyTo :Customer_Cluster ;
    :recievesGoodsFrom :Customer_Cluster ;
    rdfs:comment "Cluster Applications - Downstream system makers and service operators that integrate semiconductors into end-products and platforms—smartphones/PCs, cloud & AI data centers, automobiles, industrial automation, and connected devices. Their product roadmaps and capex set the demand signal for chips across logic, memory, analog, Radio Frequency (RF), power, and optics" ;
    rdfs:subClassOf :Customer_Cluster .

:Associations_and_Others_Cluster a :Associations_and_Others_Cluster,
        owl:Class,
        owl:NamedIndividual ;
    :flowsMoneyTo :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster ;
    :recievesInformationFrom :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster ;
    :recievesMoneyFrom :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster ;
    rdfs:comment "Cluster Others - A cross-cutting set of themes that shape disruption and growth across the entire semiconductor supply chain—above any single tier (materials, equipment, fab, OSAT). It consolidates systemic risks and opportunities. The cluster’s purpose is to track leading indicators and translate them into playbooks for mitigation and investment." ;
    rdfs:subClassOf :Industrial_Alliance_Supply_Chain_Cluster .

:Equipment_Cluster a :Equipment_Cluster,
        owl:Class,
        owl:NamedIndividual ;
    :flowsGoodsTo :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster,
        :Silicon_Foundry_and_Integrated_Device_Manufacturer_Frontend_Cluster ;
    :recievesInformationFrom :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster,
        :Silicon_Foundry_and_Integrated_Device_Manufacturer_Frontend_Cluster ;
    :recievesMoneyFrom :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster,
        :Silicon_Foundry_and_Integrated_Device_Manufacturer_Frontend_Cluster ;
    rdfs:comment "Cluster Equipment - Semiconductor equipment covers the capital tools that make, inspect, assemble, and test chips—lithography scanners, deposition and etch tools, cleaning, metrology & inspection, vacuum/abatement, and automated test systems. These high-value, long-lead assets enable patterning, materials engineering, yield control, and back-end test/packaging across fabs." ;
    rdfs:subClassOf :Industrial_Alliance_Supply_Chain_Cluster .

:Materials_Cluster a :Materials_Cluster,
        owl:Class,
        owl:NamedIndividual ;
    :flowsGoodsTo :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster,
        :Silicon_Foundry_and_Integrated_Device_Manufacturer_Frontend_Cluster ;
    :recievesInformationFrom :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster,
        :Silicon_Foundry_and_Integrated_Device_Manufacturer_Frontend_Cluster ;
    :recievesMoneyFrom :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster,
        :Silicon_Foundry_and_Integrated_Device_Manufacturer_Frontend_Cluster ;
    rdfs:comment "Cluster Material - In semiconductor manufacturing, “materials” are the ultra-high-purity substances and consumables used to fabricate and package devices (e.g., silicon wafers/substrates, process gases, wet chemicals, photoresists, metals and dielectrics, Chemical Mechanical Planarization slurries, and packaging/encapsulation materials)." ;
    rdfs:subClassOf :Industrial_Alliance_Supply_Chain_Cluster .

:Regional_Concentration a owl:Class ;
    rdfs:comment """MC_r = SUM over i in Co of (MC_i * P_ir).
MC_r = total market cap attributed to region r.
MC_i = hasMarketCapitalizationValueBillionsUSD on this individual.
P_ir = hasProportionInRegion on this individual (preliminary assumption, to be refined).
Co = all Company individuals. Sum of P_ir per company across all regions = 1.0.
Total Market Cap: MC_T = SUM from r=1 to n of MC_r.""" ;
    rdfs:subClassOf :Report .

:Market_Capitalization a owl:Class ;
    rdfs:comment """MC_j = SUM over i in Co of (P_ij * MC_i).
MC_i = hasMarketCapitalizationValueUSD on this individual.
P_ij = hasProportionInCluster on this individual (preliminary assumption, to be refined).
Co = all Company individuals. Sum of hasProportionInCluster per company across all clusters = 1.0.""" ;
    rdfs:subClassOf :Report .

:Region a owl:Class ;
    rdfs:comment "A geographic area (typically a country or country group) used to localise actors and aggregate market data within the semiconductor ecosystem. Subclasses cover the regions most relevant to semiconductor market capitalization analysis: USA, China, Taiwan, South_Korea, Japan, and Other. Linked to Organisation via hasHeadquartersIn and to Regional_Concentration via reportsOnRegion." .

:Fabless_Cluster a :Fabless_Cluster,
        owl:Class,
        owl:NamedIndividual ;
    :flowsGoodsTo :Silicon_Foundry_and_Integrated_Device_Manufacturer_Frontend_Cluster ;
    :flowsInformationTo :Intellectual_Property_and_Electronic_Design_Automation_Cluster ;
    :flowsMoneyTo :Intellectual_Property_and_Electronic_Design_Automation_Cluster ;
    :recievesGoodsFrom :Intellectual_Property_and_Electronic_Design_Automation_Cluster ;
    :recievesInformationFrom :Silicon_Foundry_and_Integrated_Device_Manufacturer_Frontend_Cluster ;
    :recievesMoneyFrom :Silicon_Foundry_and_Integrated_Device_Manufacturer_Frontend_Cluster ;
    rdfs:comment "Cluster Fabless - Fabless semiconductor companies design and sell chips while outsourcing wafer fabrication to foundries (e.g., TSMC), letting them focus capital on architecture, IP, and go-to-market instead of owning fabs." ;
    rdfs:subClassOf :Industrial_Alliance_Supply_Chain_Cluster .

:Photonics_Cluster a :Photonics_Cluster,
        owl:Class,
        owl:NamedIndividual ;
    :flowsGoodsTo :Customer_Cluster ;
    :flowsInformationTo :Intellectual_Property_and_Electronic_Design_Automation_Cluster ;
    :flowsMoneyTo :Intellectual_Property_and_Electronic_Design_Automation_Cluster ;
    :recievesGoodsFrom :Intellectual_Property_and_Electronic_Design_Automation_Cluster ;
    :recievesInformationFrom :Customer_Cluster ;
    :recievesMoneyFrom :Customer_Cluster ;
    rdfs:comment "Cluster Photonics - Photonics in semiconductors encompasses integrated photonics and optical interconnects—using silicon, silicon nitride, and III–V compound semiconductor photonic chips such as indium phosphide—with lasers, modulators, detectors, optical digital signal processors, and transceiver modules. These technologies are used for data centers, telecommunications, and sensing." ;
    rdfs:subClassOf :Industrial_Alliance_Supply_Chain_Cluster .

:Industrial_Alliance_Supply_Chain_Cluster a owl:Class ;
    rdfs:comment "A Cluster representing one of the segments of the semiconductor supply chain as defined by the Industrial Alliance on Processors and Semiconductor Technologies. Subclasses cover the full upstream value chain (e.g. Materials, Equipment, IP/EDA, Fabless, Silicon Foundry/IDM Frontend, OSAT/IDM Backend, Photonics, R&D/Academia, Associations) as well as downstream Customer_Cluster segments." ;
    rdfs:subClassOf :Cluster .

:Customer_Cluster a :Customer_Cluster,
        owl:Class,
        owl:NamedIndividual ;
    :flowsGoodsTo :Applications_Cluster ;
    :flowsInformationTo :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster,
        :Photonics_Cluster ;
    :flowsMoneyTo :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster,
        :Photonics_Cluster ;
    :recievesGoodsFrom :Outsourced_Semiconductor_Assembly_and_Test_and_Integrated_Device_Manufacturer_Backend_Cluster,
        :Photonics_Cluster ;
    :recievesInformationFrom :Applications_Cluster ;
    :recievesMoneyFrom :Applications_Cluster ;
    rdfs:comment "A Cluster representing downstream consumers of semiconductor products. Customer_Cluster groups together organisations that integrate semiconductor components into higher-level products or systems. Subclasses include Applications_Cluster, Components_Cluster, and Electronic_Manufacturing_Services_and_Original_Design_Manufacturer_Cluster." ;
    rdfs:subClassOf :Industrial_Alliance_Supply_Chain_Cluster .

