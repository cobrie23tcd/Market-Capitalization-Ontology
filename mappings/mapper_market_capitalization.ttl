@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix :    <http://www.semanticweb.org/schlosseryan/ontologies/2026/2/MarketCapitalizationOntology/> .

# ─────────────────────────────────────────────────────────────────────────
#  Market_Capitalization report individuals
#  One row per company–snapshotDate–cluster observation.
#  Source columns:
#    company, snapshotDate, reportsOnCluster,
#    hasMarketCapitalizationValueBillionsUSD, hasProportionInCluster
# ─────────────────────────────────────────────────────────────────────────

<#TriplesMapMarketCap>
    rml:logicalSource [
        rml:source               "data/market_capitalization.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "http://www.semanticweb.org/schlosseryan/ontologies/2026/2/MarketCapitalizationOntology/Market_Capitalization_{company}_{snapshotDate}_{reportsOnCluster}" ;
        rr:class owl:NamedIndividual ;
        rr:class :Market_Capitalization
    ] ;

    ## ── Object Properties (2) ───────────────────────────────────────────

    rr:predicateObjectMap [
        rr:predicate :reportsOnCompany ;
        rr:objectMap [
            rr:template "http://www.semanticweb.org/schlosseryan/ontologies/2026/2/MarketCapitalizationOntology/{company}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate :reportsOnCluster ;
        rr:objectMap [
            rr:template "http://www.semanticweb.org/schlosseryan/ontologies/2026/2/MarketCapitalizationOntology/{reportsOnCluster}" ;
            rr:termType rr:IRI
        ]
    ] ;

    ## ── Data Properties (3) ─────────────────────────────────────────────

    rr:predicateObjectMap [
        rr:predicate :hasMarketCapitalizationValueBillionsUSD ;
        rr:objectMap [
            rml:reference "hasMarketCapitalizationValueBillionsUSD" ;
            rr:datatype   xsd:decimal
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate :hasProportionInCluster ;
        rr:objectMap [
            rml:reference "hasProportionInCluster" ;
            rr:datatype   xsd:decimal
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate :snapshotDate ;
        rr:objectMap [
            rml:reference "snapshotDate" ;
            rr:datatype   xsd:string
        ]
    ] .
